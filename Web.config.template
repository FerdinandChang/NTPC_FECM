<?xml version="1.0" encoding="utf-8"?>
<!--
  新北市固定逸散源管理平台 (NTPC_FEC / NTPC_FECM) 標準設定範本
  適用情境：部署至正式機或測試機 IIS 站台（特別是 IIS 虛擬子應用程式環境）
  
  【部署注意事項】：
  1. 連線字串請依正式機 SQL Server 環境替換 MainConnectionString 與 AirQualityConnectionString。
  2. 若站台位於 IIS 子應用程式（如 /NTPC_FECM），切勿在 <customHeaders> 重複宣告根站台已存在的安全標頭（如 X-Frame-Options 等），否則會觸發 HTTP 500.19 重複項目錯誤。
  3. 整合管線模式下切勿在 <system.web> 加入 <httpModules>，本專案一律使用 <system.webServer><modules> 註冊 AuthModule。
-->
<configuration>
  <appSettings>
    <!-- SMTP 發信伺服器設定 -->
    <add key="SMTPserver" value="msr.hinet.net" />
    <add key="EmailAddr" value="your_notification@epd.gov.tw" />
    <add key="SMTP_User" value="your_smtp_user" />
    <add key="SMTP_Password" value="YOUR_SMTP_PASSWORD" />
    <add key="CCEmail" value="your_cc@epd.gov.tw" />
  </appSettings>
  <connectionStrings>
    <!-- 主資料庫連線 (包含使用者帳號、各系統巡查主表) -->
    <add name="MainConnectionString" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=NTPC_FEC;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD" providerName="System.Data.SqlClient" />
    <!-- 空品資料庫連線 (包含施工機具相關連線) -->
    <add name="AirQualityConnectionString" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=NTPC_AirQuality;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD" providerName="System.Data.SqlClient" />
    <!-- 環境部施工機具分析資料庫連線 (NTPCEPD_New) -->
    <add name="EPDConnectionString" connectionString="Data Source=EPB-AIR-WEB2\SQLEXPRESS;Initial Catalog=NTPCEPD_New;User ID=epd;Password=epd123" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="zh-TW" uiCulture="zh-TW" />
    <!-- 依據公務機關資安規範，Web 系統使用者閒置逾時上限為 30 分鐘 -->
    <sessionState timeout="30" cookieSameSite="Lax" />
    <!-- 資安規範：正式機隱藏詳細例外訊息以防敏感資訊洩漏，本地開發保留原生錯誤 -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <compilation debug="false" targetFramework="4.8" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <!-- 檔案上傳上限 100MB (102400 KB)，執行逾時 600 秒；fcnMode="Disabled" 防止上傳/刪除照片目錄觸發 AppDomain 重啟清空 Session -->
    <httpRuntime targetFramework="4.8" maxRequestLength="102400" executionTimeout="600" enableVersionHeader="false" fcnMode="Disabled" />
  </system.web>
  <system.webServer>
    <!-- 全域效能優化：啟用 IIS 動態與靜態內容 Gzip/Deflate 壓縮 (節省 80% 傳輸體積與下載時間) -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <!-- 全域資安控管模組：自動進行 Session 驗證、防暴力破解、目錄遍歷攔截與 CSRF 雙重防禦 -->
      <add name="AuthModule" type="NTPC_FEC.Security.AuthModule, NTPC_FEC" />
    </modules>
    <security>
      <!-- allowDoubleEscaping 啟用以支援含中文、括號與空格之檔案路徑 -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="104857600" />
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".jpg" allowed="true" />
          <add fileExtension=".jpeg" allowed="true" />
          <add fileExtension=".png" allowed="true" />
          <add fileExtension=".gif" allowed="true" />
          <add fileExtension=".bmp" allowed="true" />
          <add fileExtension=".webp" allowed="true" />
          <add fileExtension=".pdf" allowed="true" />
          <add fileExtension=".woff" allowed="true" />
          <add fileExtension=".woff2" allowed="true" />
          <add fileExtension=".ttf" allowed="true" />
          <add fileExtension=".otf" allowed="true" />
          <add fileExtension=".eot" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <staticContent>
      <!-- 外勤行動載具效能優化：靜態字型、CSS、圖片與核心庫啟用 7 天用戶端快取 (搭配 ?v= 版號機制安全更新) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="application/font-sfnt" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- 解除 IIS 全域繼承之 COEP 限制，允許國土測繪圖資 WMTS 與開源地圖正常嵌入載入 -->
        <remove name="Cross-Origin-Embedder-Policy" />
        <add name="Cross-Origin-Embedder-Policy" value="unsafe-none" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
